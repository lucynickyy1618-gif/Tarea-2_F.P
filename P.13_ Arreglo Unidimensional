#include <stdio.h>
int main() {
int n, suma = 0;
printf("Ingrese el tamaño del arreglo: ");
scanf("%d", &n);   
  
int arreglo[n];
    
    // Lectura de elementos
    printf("Ingrese los %d elementos:\n", n);
    for (int i = 0; i < n; i++) {
    printf("Elemento %d: ", i + 1);
    scanf("%d", &arreglo[i]);
    suma += arreglo[i]; // Sumamos directamente
    }
    
    // Salida del resultado
    printf("\nLa suma de los elementos del arreglo es: %d\n", suma);
    
    return 0;
}
