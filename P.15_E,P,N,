#include <stdio.h>

int main() {
    int n, positivos = 0, negativos = 0, nulos = 0;
    
    printf("Ingrese el tamaño del arreglo: ");
    scanf("%d", &n);
    
    int arreglo[n];
    
    // Lectura y clasificación de elementos
    printf("Ingrese los %d elementos:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Elemento %d: ", i + 1);
        scanf("%d", &arreglo[i]);
        
        if (arreglo[i] > 0) {
            positivos++;
        } else if (arreglo[i] < 0) {
            negativos++;
        } else {
            nulos++;
        }
    }
    
    // Salida de resultados
    printf("\n--- Resultados ---\n");
    printf("Positivos: %d\n", positivos);
    printf("Negativos: %d\n", negativos);
    printf("Nulos (ceros): %d\n", nulos);
    
    return 0;
}
