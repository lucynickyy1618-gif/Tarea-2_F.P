Problema 5*/

#include <stdio.h>
int main() {
float compra, total;
    
// Entrada de datos
    printf("Ingrese el monto de la compra: ");
    scanf("%f", &compra);
    
// Condición para aplicar el descuento del 8%
    if (compra > 2500) {
        total = compra - (compra * 0.08);
        printf("¡Se aplicó un 8%% de descuento!\n");
    } else {
        total = compra;
    }
    
// Salida de resultados
    printf("El total a pagar es: $%.2f\n", total);
    
    return 0;
}
